{
  "name": "av-ui",
  "version": "0.1.0",
  "description": "Shared design system for the AV apps (Clip FX, MMV, ...)",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./fonts.css": "./dist/fonts.css"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "scripts": {
    "tokens": "node tokens/build.ts",
    "build": "npm run tokens && vite build && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "lint": "biome check . && stylelint \"src/**/*.css\"",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "dev": "vite --config tests/harness/vite.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stylelint": "^18.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0"
  }
}
